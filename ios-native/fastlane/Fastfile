default_platform(:ios)

platform :ios do
  desc "Build Bloom and upload to TestFlight (cert + sigh + ASC API key)"
  lane :beta do
    setup_ci(force: true) if ENV["CI"]

    key_path = File.expand_path("AuthKey.p8", Dir.pwd)
    File.write(key_path, ENV.fetch("APP_STORE_CONNECT_API_KEY"))
    File.chmod(0600, key_path)

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: key_path,
      duration: 1200,
      in_house: false
    )

    # Install Apple Distribution cert + App Store profiles into the CI keychain.
    # Automatic/cloud signing failed on GHA with "Cloud signing permission error".
    cert(
      api_key: api_key,
      development: false
    )

    sigh(
      api_key: api_key,
      app_identifier: "com.akemi01.bloom",
      force: true
    )
    bloom_profile_name = lane_context[SharedValues::SIGH_NAME]
    bloom_profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]

    sigh(
      api_key: api_key,
      app_identifier: "com.akemi01.bloom.widget",
      force: true
    )
    widget_profile_name = lane_context[SharedValues::SIGH_NAME]
    widget_profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]

    UI.message("Bloom profile: #{bloom_profile_name} (#{bloom_profile_path})")
    UI.message("Widget profile: #{widget_profile_name} (#{widget_profile_path})")

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Bloom.xcodeproj",
      team_id: "LLU2292H63",
      code_sign_identity: "iPhone Distribution",
      profile_name: bloom_profile_name,
      targets: ["Bloom"]
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Bloom.xcodeproj",
      team_id: "LLU2292H63",
      code_sign_identity: "iPhone Distribution",
      profile_name: widget_profile_name,
      targets: ["BloomWidget"]
    )

    build_app(
      project: "Bloom.xcodeproj",
      scheme: "Bloom",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "Bloom.ipa",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: "LLU2292H63",
        provisioningProfiles: {
          "com.akemi01.bloom" => bloom_profile_name,
          "com.akemi01.bloom.widget" => widget_profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: "CI build from GitHub Actions"
    )
  ensure
    File.delete(key_path) if defined?(key_path) && key_path && File.exist?(key_path)
  end
end
