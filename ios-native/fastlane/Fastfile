default_platform(:ios)

platform :ios do
  desc "Build Bloom and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
      duration: 1200,
      in_house: false
    )

    setup_ci(force: true) if ENV["CI"]

    # Creates/updates distribution cert + App Store profiles via ASC API
    get_certificates(api_key: api_key)
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.akemi01.bloom",
      readonly: false
    )
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.akemi01.bloom.widget",
      readonly: false
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Bloom.xcodeproj",
      team_id: "LLU2292H63",
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME],
      targets: ["Bloom"]
    )

    build_app(
      project: "Bloom.xcodeproj",
      scheme: "Bloom",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "Bloom.ipa",
      xcargs: "-allowProvisioningUpdates DEVELOPMENT_TEAM=LLU2292H63"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: "CI build from GitHub Actions (build 20+)"
    )
  end
end
