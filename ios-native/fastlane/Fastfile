default_platform(:ios)

platform :ios do
  desc "Build Bloom and upload to TestFlight (automatic signing + ASC API key)"
  lane :beta do
    setup_ci(force: true) if ENV["CI"]

    key_path = File.expand_path("AuthKey.p8", Dir.pwd)
    File.write(key_path, ENV.fetch("APP_STORE_CONNECT_API_KEY"))
    File.chmod(0600, key_path)

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: key_path,
      duration: 1200,
      in_house: false
    )

    # Automatic signing + ASC API auth — avoids get_certificates keychain errors on GHA
    update_code_signing_settings(
      use_automatic_signing: true,
      path: "Bloom.xcodeproj",
      team_id: "LLU2292H63",
      targets: ["Bloom", "BloomWidget"]
    )

    # Pass auth flags only via xcargs. gym also feeds xcargs into export;
    # setting the same flags again in export_xcargs makes xcodebuild error with
    # "option '-authenticationKeyPath' may only be provided once".
    auth_xcargs = [
      "DEVELOPMENT_TEAM=LLU2292H63",
      "-allowProvisioningUpdates",
      "-allowProvisioningDeviceRegistration",
      "-authenticationKeyPath #{key_path}",
      "-authenticationKeyID #{ENV.fetch('APP_STORE_CONNECT_API_KEY_ID')}",
      "-authenticationKeyIssuerID #{ENV.fetch('APP_STORE_CONNECT_ISSUER_ID')}"
    ].join(" ")

    build_app(
      project: "Bloom.xcodeproj",
      scheme: "Bloom",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "Bloom.ipa",
      xcargs: auth_xcargs
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: "CI build from GitHub Actions"
    )
  ensure
    File.delete(key_path) if defined?(key_path) && key_path && File.exist?(key_path)
  end
end
