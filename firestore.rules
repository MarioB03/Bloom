rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if viewer has active link to owner
    function hasActiveLink(ownerId, viewerId) {
      return exists(/databases/$(database)/documents/users/$(ownerId)/viewers/$(viewerId))
        && get(/databases/$(database)/documents/users/$(ownerId)/viewers/$(viewerId)).data.status == 'active';
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Viewer can read owner's profile
      allow read: if request.auth != null && hasActiveLink(userId, request.auth.uid);

      match /checkins/{checkinId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Viewer read-only
        allow read: if request.auth != null && hasActiveLink(userId, request.auth.uid);
      }

      match /gratitude/{gratitudeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Viewer read-only
        allow read: if request.auth != null && hasActiveLink(userId, request.auth.uid);
      }

      match /registers/{registerId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Viewer read-only — only if register is marked as shared
        allow read: if request.auth != null
          && hasActiveLink(userId, request.auth.uid)
          && resource.data.sharedVisible == true;
      }

      match /skillPractice/{practiceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /safetyPlan/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Viewer subcollection: users/{ownerId}/viewers/{viewerId}
      match /viewers/{viewerId} {
        // Both owner and viewer can read
        allow read: if request.auth != null
          && (request.auth.uid == userId || request.auth.uid == viewerId);

        // Viewer creates the link (when redeeming a code)
        allow create: if request.auth != null
          && request.auth.uid == viewerId
          && request.resource.data.status == 'active';

        // Owner can revoke
        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.status == 'revoked';

        // Owner can delete
        allow delete: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // Reverse lookup: viewer can read their own link, viewer creates, owner revokes
    match /viewerLinks/{viewerId} {
      allow read: if request.auth != null && request.auth.uid == viewerId;
      allow create: if request.auth != null && request.auth.uid == viewerId;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.ownerId
        && request.resource.data.status == 'revoked';
      // Viewer can delete their own link (account deletion)
      allow delete: if request.auth != null && request.auth.uid == viewerId;
    }

    match /sharingCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
      allow update: if false;
    }

    match /skills/{skillId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /templates/{templateId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /premiumCodes/{code} {
      // Any authenticated user can read (to redeem)
      allow read: if request.auth != null;
      // Only admin can create codes
      allow create: if request.auth != null
        && request.auth.uid == 'IUrBhjLrTLZZkwuj8B8qSXRX7iH3';
      // Any authenticated user can update (to mark as redeemed)
      allow update: if request.auth != null
        && resource.data.status == 'active'
        && request.resource.data.status == 'redeemed'
        && request.resource.data.redeemedBy == request.auth.uid;
      allow delete: if false;
    }
  }
}
