{
  "expo": {
    "name": "Bloom",
    "slug": "bloom-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "bloom",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF6F0"
    },
    "ios": {
      "supportsTablet": false,
      "buildNumber": "7",
      "jsEngine": "jsc",
      "bundleIdentifier": "com.akemi01.bloom",
      "appleTeamId": "LLU2292H63",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "Bloom usa notificaciones para enviarte recordatorios diarios de bienestar emocional."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF6F0"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.bloom.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.873083945404-32291l9qg9lp7fkrufp34mb2e39fiale"
        }
      ],
      "@bacons/apple-targets",
      "./plugins/withWidgetReload"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3251f5f3-65ec-4981-b92b-713a469a77ad",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "BloomWidget",
                  "bundleIdentifier": "com.akemi01.bloom.BloomWidget"
                }
              ]
            }
          }
        }
      }
    },
    "owner": "akemi01"
  }
}
